/* app.wxss 全局样式 */
page {
  --color-primary: #2e7d5b;
  --color-primary-soft: #eef4f0;
  --color-sprout: #79b86a;
  --color-warm: #f4eadb;
  --color-danger: #b34e48;
  --color-warning: #9b6819;
  --color-text: #26352c;
  --color-text-secondary: #6b7a70;
  --color-text-muted: #8a9b90;
  --color-surface: #ffffff;
  --color-page: #f4f7f5;
  --radius-card: 20rpx;
  --radius-button: 44rpx;
  --space-page: 24rpx;
  --shadow-card: 0 4rpx 16rpx rgba(46, 125, 91, 0.06);
  background-color: #f4f7f5;
  color: #26352c;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  box-sizing: border-box;
}

view, text, input, textarea, button, image, scroll-view {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.load-hint { color: #6b7a70; font-size: 26rpx; }
.load-error { color: #b34e48; font-size: 26rpx; }

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 91, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin-bottom: 16rpx;
  color: #26352c;
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  min-height: 64rpx;
  line-height: 64rpx;
  padding-left: 24rpx;
  color: #2e7d5b;
  font-size: 24rpx;
  font-weight: 400;
}

.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* 通用按钮 */
.btn-primary {
  background: #2e7d5b;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0 40rpx;
  line-height: 80rpx;
  height: 80rpx;
  text-align: center;
  margin: 16rpx 0;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled],
.btn-ghost[disabled],
.btn-danger[disabled] {
  opacity: 0.55;
  color: inherit;
}

.btn-ghost {
  background: #eef4f0;
  color: #2e7d5b;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  height: 72rpx;
  text-align: center;
  margin: 12rpx 0;
}

.btn-ghost::after {
  border: none;
}

.btn-danger {
  background: #f7ecea;
  color: #c0554f;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  height: 72rpx;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

/* 标签 / 徽标 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  margin-right: 12rpx;
}

.tag-green { background: #e2f2e9; color: #2e7d5b; }
.tag-amber { background: #fdf3e0; color: #b07a20; }
.tag-red   { background: #fbe9e7; color: #c0554f; }
.tag-gray  { background: #eef1ef; color: #6b7a70; }
.tag-blue  { background: #e6f0fa; color: #2a6fa8; }

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid #eef1ef;
}

.form-label {
  width: 180rpx;
  color: #5b6a60;
  font-size: 28rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #26352c;
}

.form-placeholder {
  color: #b6c0ba;
}

.form-unit {
  color: #8a9b90;
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* 页头 */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 12rpx 0 20rpx;
}

.empty {
  text-align: center;
  color: #8a9b90;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty.small {
  padding: 48rpx 20rpx;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 可选标签 / 选项卡片 */
.tag-field { align-items: flex-start; }
.tag-choices { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-choice {
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  background: #f2f5f3;
  color: #5b6a60;
  font-size: 24rpx;
  line-height: 40rpx;
}
.tag-choice.is-on { background: #2e7d5b; color: #ffffff; }
.tag-choice.is-add { background: #ffffff; color: #2e7d5b; border: 1rpx dashed #9cc4b0; }
.tag-hint { width: 100%; color: #8a9b90; font-size: 22rpx; }

/* 分段切换 */
.segmented {
  display: flex;
  background: #eef4f0;
  border-radius: 36rpx;
  padding: 6rpx;
}
.segmented-item {
  flex: 1;
  text-align: center;
  line-height: 60rpx;
  border-radius: 30rpx;
  color: #5b6a60;
  font-size: 26rpx;
}
.segmented-item.is-on { background: #ffffff; color: #2e7d5b; font-weight: 600; }

/* 通用列表行 */
.list-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #eef1ef;
}
.list-row:last-child { border-bottom: none; }
.list-main { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: 20rpx; }
.list-title { color: #26352c; font-size: 28rpx; font-weight: 600; }
.list-sub { color: #8a9b90; font-size: 24rpx; margin-top: 4rpx; }
.list-side { color: #26352c; font-size: 28rpx; font-weight: 600; margin-left: 16rpx; }
.list-action { color: #2e7d5b; font-size: 26rpx; padding: 12rpx 0 12rpx 20rpx; }
.list-action.is-danger { color: #c0554f; }

.fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(247, 250, 248, 0.96);
  box-shadow: 0 -4rpx 16rpx rgba(46, 125, 91, 0.06);
  z-index: 20;
}
.fixed-bar .btn-primary { width: 100%; margin: 0; }
.has-fixed-bar { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
