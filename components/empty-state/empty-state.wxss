.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  text-align: center;
}
.empty-state.compact { padding: 40rpx 24rpx; }
.illustration { width: 280rpx; height: 220rpx; }
.compact .illustration { width: 200rpx; height: 150rpx; }
.title { color: #44544a; font-size: 28rpx; font-weight: 600; }
.description { margin-top: 12rpx; color: #8a9b90; font-size: 24rpx; line-height: 1.55; }
.action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 280rpx;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 40rpx;
  border-radius: 44rpx;
  background: #2e7d5b;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
}
