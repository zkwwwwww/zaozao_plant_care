.notice-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 36rpx; }
.notice-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(26, 47, 35, .48); }
.notice-card { position: relative; display: flex; flex-direction: column; width: 100%; max-width: 660rpx; max-height: 88vh; overflow: hidden; padding: 40rpx 32rpx 24rpx; border-radius: 32rpx; background: radial-gradient(ellipse at 100% 0, #e0eedf, transparent 55%), #fffdf7; box-shadow: 0 24rpx 80rpx rgba(17, 43, 29, .2); animation: notice-enter .38s ease-out both; box-sizing: border-box; }
.notice-kicker { display: block; color: #699177; font-size: 22rpx; letter-spacing: 3rpx; }
.notice-title { display: block; margin-top: 12rpx; color: #26352c; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.notice-description { display: block; margin: 16rpx 0 24rpx; font-size: 25rpx; line-height: 1.6; color: #6b7a70; }
.notice-content { height: 34vh; min-height: 0; flex-shrink: 1; }
.notice-kicker, .notice-title, .notice-description, .notice-progress, .notice-primary, .notice-secondary, .notice-art { flex-shrink: 0; }
.release-row { display: flex; gap: 14rpx; padding: 14rpx 0; font-size: 26rpx; line-height: 1.6; color: #405a48; }
.release-dot { flex: 0 0 10rpx; height: 10rpx; margin-top: 15rpx; background: #79b86a; border-radius: 50%; }
.notice-group { margin-bottom: 20rpx; padding: 18rpx; background: #eef4f0; border-radius: 16rpx; }
.notice-group.overdue { background: #fbefeb; }
.notice-group.upcoming { background: #f7f1e5; }
.group-heading { display: flex; justify-content: space-between; color: #2e7d5b; font-size: 25rpx; font-weight: 600; margin-bottom: 10rpx; }
.overdue .group-heading { color: #b34e48; }
.upcoming .group-heading { color: #9b6819; }
.notice-task { display: flex; gap: 12rpx; padding: 10rpx 0; align-items: center; }
.task-title { flex: 1; min-width: 0; font-size: 24rpx; color: #405a48; word-break: break-all; }
.task-time { flex-shrink: 0; font-size: 21rpx; color: #8a9b90; }
.more-hint { display: block; margin-top: 8rpx; font-size: 21rpx; color: #8a9b90; }
.notice-progress { margin: 22rpx 0; }
.progress-label { display: flex; justify-content: space-between; margin-bottom: 10rpx; color: #6b7a70; font-size: 22rpx; }
.progress-track { height: 12rpx; background: #e4ebe2; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #79b86a, #2e7d5b); border-radius: 8rpx; animation: progress-grow .7s ease-out both; }
.notice-primary { margin: 24rpx 0 0; background: #2e7d5b; color: #fff; border-radius: 40rpx; padding: 16rpx 20rpx; font-size: 28rpx; line-height: 1.5; }
.notice-secondary { margin: 8rpx 0 0; padding: 18rpx 0; background: transparent; color: #6b7a70; font-size: 23rpx; line-height: 1.4; }
button::after { border: none; }
.is-celebrating { text-align: center; }
.notice-art { position: relative; width: 160rpx; height: 152rpx; margin: 0 auto 28rpx; animation: sprout-rise .6s ease-out both; }
.sprout-stem { position: absolute; bottom: 16rpx; left: 76rpx; width: 8rpx; height: 94rpx; background: #2e7d5b; border-radius: 4rpx; }
.sprout-leaf { position: absolute; width: 68rpx; height: 40rpx; background: #79b86a; }
.sprout-leaf.left { top: 30rpx; left: 14rpx; border-radius: 4rpx 40rpx 4rpx 40rpx; transform: rotate(25deg); }
.sprout-leaf.right { top: 12rpx; right: 8rpx; border-radius: 40rpx 4rpx 40rpx 4rpx; transform: rotate(-20deg); background: #2e7d5b; }
.sprout-ground { position: absolute; bottom: 2rpx; left: 12rpx; width: 136rpx; height: 20rpx; border-radius: 50%; background: #e2ead5; }
.confetti { position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; overflow: hidden; }
.confetti-piece { position: absolute; top: -24rpx; width: 10rpx; height: 22rpx; border-radius: 3rpx; animation: confetti-fall 1.8s ease-out both; }
@keyframes notice-enter { from { opacity: 0; transform: translateY(35rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes sprout-rise { from { opacity: 0; transform: scale(.7) translateY(20rpx); } to { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes progress-grow { from { transform: scaleX(0); transform-origin: left; } to { transform: scaleX(1); transform-origin: left; } }
@keyframes confetti-fall { 0% { opacity: 0; transform: translateY(0) rotate(0); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateY(550rpx) rotate(220deg); } }
