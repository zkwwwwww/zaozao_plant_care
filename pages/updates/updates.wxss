.updates-intro { display: block; margin-bottom: 32rpx; font-size: 25rpx; color: #6b7a70; line-height: 1.6; }
.release-card { border-left: 6rpx solid #79b86a; }
.release-meta { display: flex; justify-content: space-between; color: #8a9b90; font-size: 23rpx; }
.release-version { color: #2e7d5b; font-weight: 600; }
.release-title { display: block; margin: 20rpx 0; font-size: 32rpx; font-weight: 700; }
.release-item { display: flex; gap: 16rpx; padding: 12rpx 0; font-size: 26rpx; line-height: 1.7; color: #405a48; }
.release-mark { width: 10rpx; height: 10rpx; margin-top: 16rpx; border-radius: 50%; background: #79b86a; flex-shrink: 0; }
