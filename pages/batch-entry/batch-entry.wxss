.mode-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.mode-chip {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #f2f5f3;
  color: #6b7a70;
  font-size: 24rpx;
}
.mode-chip.is-on { background: #2e7d5b; color: #ffffff; font-weight: 600; }
.hint { display: block; color: #8a9b90; font-size: 22rpx; line-height: 1.5; }
.tag-field { align-items: flex-start; }
.tag-choices { display: flex; flex: 1; flex-wrap: wrap; gap: 12rpx; }
.tag-choice {
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #f2f5f3;
  color: #6b7a70;
  font-size: 22rpx;
}
.tag-choice.is-on { background: #e2f2e9; color: #2e7d5b; }
.batch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}
.batch-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #eef4f0;
  color: #2e7d5b;
  font-size: 36rpx;
  line-height: 88rpx;
  text-align: center;
  overflow: hidden;
}
.batch-photo image { width: 88rpx; height: 88rpx; display: block; }
.batch-name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f4f7f5;
  font-size: 26rpx;
}
.batch-remove { color: #b34e48; font-size: 24rpx; }
.btn-ghost { margin-bottom: 16rpx; }
.btn-primary { margin-top: 8rpx; margin-bottom: 40rpx; }
