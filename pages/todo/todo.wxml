<view class="container">
  <view class="card load-error" wx:if="{{loadError}}" bindtap="load">{{loadError}}，点此重试</view>
  <view class="card load-hint" wx:elif="{{loading && !groups.length}}">正在整理待办…</view>

  <view class="card" wx:for="{{groups}}" wx:for-item="group" wx:key="type">
    <view class="section-title">
      <text>{{group.label}}（{{group.items.length}}）</text>
      <text class="section-more" data-type="{{group.type}}" bindtap="completeGroup">一键完成</text>
    </view>
    <task-row
      wx:for="{{group.items}}"
      wx:key="plantId"
      item-id="{{item.plantId}}"
      task-type="{{item.type}}"
      photo="{{item.photo}}"
      title="{{item.plantName}}"
      subtitle="到期 {{item.due}}"
      status-text="{{item.dueText}}"
      status-class="{{item.cls}}"
      show-complete="{{true}}"
      bind:select="goDetail"
      bind:complete="completeOne"
    ></task-row>
  </view>

  <empty-state
    wx:if="{{!groups.length && !loading && !loadError}}"
    image="/assets/illustrations/empty-reminders.png"
    title="今天没有到期的养护"
    description="进入提前提醒范围的安排可以在「提醒」里查看"
    button-text="查看提醒"
    bind:action="goReminders"
  ></empty-state>
</view>
