/* pages/index/index.wxss */
.container {
  padding-bottom: 24rpx;
}
.container.has-add {
  padding-bottom: 132rpx;
}

/* 小程序标识 */
.brand {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 28rpx 24rpx 20rpx;
}
.brand-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.brand-text {
  flex: 1;
  min-width: 0;
}
.brand-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #26352c;
}
.brand-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7a70;
}
.brand-login {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9b90;
}
.brand-login.is-expired {
  color: #9b6819;
}
.feature-row {
  display: flex;
  width: 100%;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef1ef;
}
.feature-item {
  flex: 1;
  min-height: 88rpx;
  text-align: center;
  padding: 0 6rpx;
}
.feature-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #2e7d5b;
}
.feature-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #8a9b90;
}
.empty-logo {
  display: block;
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  margin: 0 auto 20rpx;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a3b0a8;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 10rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2e7d5b;
}
.stat-num.warn { color: #b07a20; }
.stat-num.danger { color: #c0554f; }
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8a9b90;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1ef;
}

/* 季节提示 */
.season-tip {
  padding: 20rpx 24rpx;
}
.tip-text {
  font-size: 26rpx;
  color: #2e7d5b;
}

/* 待办行 */
.task-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}
.task-row:last-child { border-bottom: none; }
.task-photo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  background: #eef4f0;
}
.placeholder-photo {
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-icon { font-size: 40rpx; }
.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.task-name {
  font-size: 28rpx;
  font-weight: 600;
}
.task-date {
  font-size: 22rpx;
  color: #8a9b90;
  margin-top: 4rpx;
}

/* 植物网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.photo-wrap plant-thumb {
  display: block;
  width: 100%;
  height: 300rpx;
}
.plant-card {
  width: 47.8%;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 91, 0.06);
}
.photo-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #eef4f0;
}
.plant-photo {
  width: 100%;
  height: 300rpx;
  display: block;
}
.plant-photo.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(255, 255, 255, 0.92);
}
.plant-body {
  padding: 18rpx;
}
.plant-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.plant-name {
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.plant-price {
  font-size: 24rpx;
  color: #2e7d5b;
  font-weight: 600;
  padding: 4rpx 0 4rpx 12rpx;
}
.is-masked {
  letter-spacing: 2rpx;
  color: #8a9b90;
}
.plant-meta {
  display: block;
  font-size: 22rpx;
  color: #6b7a70;
  margin-top: 8rpx;
}
.plant-env {
  display: inline-block;
  font-size: 20rpx;
  color: #2a6fa8;
  background: #e6f0fa;
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-top: 12rpx;
}
.water-tip {
  display: block;
  font-size: 22rpx;
  margin-top: 12rpx;
}
.water-tip.tag-red { color: #c0554f; }
.water-tip.tag-amber { color: #b07a20; }
.water-tip.tag-green { color: #2e7d5b; }

/* 添加按钮 */
.add-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 24rpx;
  background: linear-gradient(180deg, rgba(244, 247, 245, 0), #f4f7f5 28%);
  z-index: 10;
}
.add-btn {
  display: block;
  text-align: center;
  background: #2e7d5b;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 91, 0.3);
}
