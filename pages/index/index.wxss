/* pages/index/index.wxss */
.container {
  padding-top: 16rpx;
  padding-bottom: 24rpx;
}
.container.has-add {
  padding-bottom: 132rpx;
}

/* 私人花园手札 */
.home-notebook {
  position: relative;
  overflow: hidden;
  min-height: 232rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e0e9da;
  border-radius: 24rpx;
  background: radial-gradient(ellipse at 100% 0, rgba(211, 228, 196, 0.25), transparent 62%), linear-gradient(135deg, #fffdf6, #f8fbf5);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 91, 0.04);
  animation: home-notebook-in 260ms ease-out both;
}
.home-decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 128rpx;
  height: 132rpx;
  overflow: hidden;
  pointer-events: none;
}
.home-leaf {
  position: absolute;
  width: 40rpx;
  height: 78rpx;
  border: 1rpx solid rgba(138, 169, 123, 0.08);
  border-radius: 80% 12% 80% 12%;
  background: rgba(138, 169, 123, 0.06);
}
.home-leaf.leaf-one { top: -22rpx; right: 22rpx; transform: rotate(-40deg); }
.home-leaf.leaf-two { top: 42rpx; right: -12rpx; transform: rotate(-62deg); }
.home-identity {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: 136rpx;
}
.home-avatar-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  padding: 4rpx;
  margin-right: 18rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #eaf1e4;
}
.home-avatar {
  display: block;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f4f7ef;
}
.home-copy { flex: 1; min-width: 0; }
.home-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  line-height: 28rpx;
}
.home-greeting { flex-shrink: 0; color: #6b7a70; font-size: 22rpx; }
.home-date { margin-left: 12rpx; color: #8a9b90; font-size: 20rpx; white-space: nowrap; }
.home-name-row { display: flex; align-items: center; min-width: 0; margin-top: 4rpx; }
.home-name {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #26352c;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-account-link {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #2e7d5b;
  font-size: 22rpx;
  line-height: 32rpx;
  white-space: nowrap;
}
.home-context { display: flex; align-items: center; min-width: 0; margin-top: 6rpx; line-height: 26rpx; }
.home-status {
  flex-shrink: 0;
  padding: 0 7rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  color: #6b7a70;
  background: #eef2eb;
  font-size: 20rpx;
  line-height: 26rpx;
  white-space: nowrap;
}
.home-status.active, .home-status.is-active, .home-status.valid, .home-status.is-valid { color: #2e7d5b; background: #e9f2e5; }
.home-status.expired, .home-status.is-expired { color: #9b6819; background: #f6eedf; }
.home-status.guest, .home-status.is-guest { color: #6b7a70; background: #eef2eb; }
.home-description {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #6b7a70;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-season {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 46rpx;
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #e5ecdf;
  line-height: 32rpx;
}
.home-season-text { display: flex; align-items: center; flex: 1; min-width: 0; }
.home-season-label { flex-shrink: 0; color: #2e7d5b; font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.home-season-rule {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  margin-left: 12rpx;
  color: #6b7a70;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-season-more { display: flex; align-items: center; flex-shrink: 0; margin-left: 12rpx; white-space: nowrap; }
.home-season-note { color: #6b7a70; font-size: 20rpx; }
.home-season-arrow { margin-left: 8rpx; color: #2e7d5b; font-size: 24rpx; }

@keyframes home-notebook-in {
  from { opacity: 0; transform: translateY(4rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .home-notebook { animation: none; }
}

.feature-card {
  padding: 8rpx 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.login-blur {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(38, 53, 44, 0.28);
  -webkit-backdrop-filter: blur(40px);
  backdrop-filter: blur(40px);
}
.login-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  width: 100%;
  padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}
.login-head {
  display: flex;
  align-items: center;
}
.login-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.login-apply {
  font-size: 28rpx;
  color: #26352c;
}
.login-title {
  display: block;
  margin-top: 36rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
}
.login-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a9b90;
}
.login-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  border-bottom: 1rpx solid #f0f2f1;
}
.login-label {
  width: 96rpx;
  font-size: 30rpx;
  color: #26352c;
}
.login-avatar-btn {
  width: 80rpx !important;
  height: 80rpx;
  min-height: 0;
  flex: 0 0 80rpx;
  margin: 16rpx 0;
  padding: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: transparent;
  line-height: 0;
  font-size: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-avatar-btn::after {
  border: none;
}
.login-action-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a9b90;
}
.privacy-btn {
  width: 100%;
  height: 72rpx;
  margin: 24rpx 0 0;
  padding: 0;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #f4f7f5;
  color: #2e7d5b;
  font-size: 26rpx;
}
.privacy-btn::after {
  border: none;
}
.login-avatar {
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
}
.login-album {
  margin-left: 24rpx;
  padding: 16rpx 8rpx;
  color: #2e7d5b;
  font-size: 26rpx;
}
.login-nick {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #26352c;
}
.login-nick-placeholder {
  color: #b0bbb4;
}
.login-error {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b34e48;
}
.login-actions {
  display: flex;
  margin-top: 36rpx;
}
.login-refuse,
.login-allow {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.login-refuse {
  margin-right: 24rpx;
  background: #f2f3f5;
  color: #26352c;
}
.login-allow {
  margin: 0;
  padding: 0;
  background: #07c160;
  color: #ffffff;
}
.login-allow::after {
  border: none;
}
.feature-row {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}
.feature-item {
  width: 25%;
  min-height: 88rpx;
  text-align: center;
  padding: 12rpx 6rpx;
}
.feature-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #2e7d5b;
}
.feature-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.3;
  color: #8a9b90;
}
.empty-logo {
  display: block;
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  margin: 0 auto 20rpx;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a3b0a8;
}

/* 首页紧凑概览 */
.dashboard {
  padding: 8rpx 20rpx;
  margin-bottom: 16rpx;
}
.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 18rpx 4rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2e7d5b;
}
.stat-num.warn { color: #b07a20; }
.stat-num.danger { color: #c0554f; }
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8a9b90;
  margin-top: 2rpx;
}
.stat-divider {
  width: 1rpx;
  height: 46rpx;
  background: #eef1ef;
}

/* 待办行 */
.task-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}
.task-row:last-child { border-bottom: none; }
.task-photo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  background: #eef4f0;
}
.placeholder-photo {
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-icon { font-size: 40rpx; }
.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.task-name {
  font-size: 28rpx;
  font-weight: 600;
}
.task-date {
  font-size: 22rpx;
  color: #8a9b90;
  margin-top: 4rpx;
}

/* 植物网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.grid.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; }
.grid.cols-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8rpx; }
.photo-wrap plant-thumb {
  display: block;
  width: 100%;
  height: 100%;
}
.plant-card {
  min-width: 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 91, 0.06);
}
.cols-4 .plant-card, .cols-6 .plant-card { border-radius: 12rpx; }
.photo-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #eef4f0;
}
.cols-3 .photo-wrap { height: 200rpx; }
.cols-4 .photo-wrap { height: 150rpx; }
.cols-6 .photo-wrap { height: 100rpx; }
.cols-4 .status-tag, .cols-6 .status-tag { display: none; }
.cols-3 .status-tag { top: 8rpx; left: 8rpx; font-size: 18rpx; padding: 0 10rpx; line-height: 30rpx; }
.cols-3 .plant-body, .cols-4 .plant-body { padding: 10rpx 12rpx; }
.cols-6 .plant-body { padding: 6rpx; }
.cols-3 .plant-name { font-size: 24rpx; }
.cols-4 .plant-name { font-size: 22rpx; }
.cols-6 .plant-name { font-size: 18rpx; }
.plant-photo {
  width: 100%;
  height: 300rpx;
  display: block;
}
.plant-photo.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(255, 255, 255, 0.92);
}
.plant-body {
  padding: 18rpx;
}
.plant-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.plant-meta {
  display: block;
  font-size: 22rpx;
  color: #6b7a70;
  margin-top: 8rpx;
}
.plant-env {
  display: inline-block;
  font-size: 20rpx;
  color: #2a6fa8;
  background: #e6f0fa;
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-top: 12rpx;
}
.water-tip {
  display: block;
  font-size: 22rpx;
  margin-top: 12rpx;
}
.water-tip.tag-red { color: #c0554f; }
.water-tip.tag-amber { color: #b07a20; }
.water-tip.tag-green { color: #2e7d5b; }

/* 添加按钮 */
.add-bar {
  position: fixed;
  right: 28rpx;
  bottom: 28rpx;
  z-index: 10;
}
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  text-align: center;
  background: #2e7d5b;
  color: #fff;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 91, 0.3);
}

/* 今日到期的养护，不包含逾期项目 */
.todo-row {
  display: grid;
  grid-template-columns: 120rpx minmax(0, 1fr) auto;
  column-gap: 18rpx;
  align-items: center;
  min-height: 70rpx;
  padding: 10rpx 4rpx;
  border-top: 1rpx solid #eef1ef;
}
.todo-title {
  color: #26352c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 40rpx;
}
.todo-desc {
  overflow: hidden;
  color: #6b7a70;
  font-size: 21rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.todo-swiper { width: 100%; height: 44rpx; }
.todo-slide { display: flex; align-items: center; width: 100%; height: 44rpx; }
.todo-slide-photo {
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #eef4f0;
}
.todo-slide-photo.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}
.todo-slide-text {
  overflow: hidden;
  color: #6b7a70;
  font-size: 21rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.todo-slide-text.summary { color: #6b7a70; }
.todo-count { font-size: 23rpx; color: #8a9b90; }
.todo-count.is-on { color: #b07a20; font-weight: 600; }

.month-care {
  display: grid;
  grid-template-columns: 120rpx minmax(0, 1fr) auto;
  column-gap: 18rpx;
  align-items: center;
  min-height: 70rpx;
  padding: 10rpx 4rpx;
  border-top: 1rpx solid #eef1ef;
}
.month-care-title {
  display: block;
  height: 40rpx;
  color: #26352c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 40rpx;
}
.month-care-summary {
  display: block;
  height: 40rpx;
  min-width: 0;
  overflow: hidden;
  color: #8a9b90;
  font-size: 20rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.month-care-more {
  display: block;
  height: 40rpx;
  color: #2e7d5b;
  font-size: 24rpx;
  line-height: 40rpx;
}

/* 标签筛选 */
.tag-bar { margin: 0 -24rpx 12rpx; }
.tag-scroll { width: 100%; white-space: nowrap; padding: 0 24rpx; box-sizing: border-box; }
.tag-chip {
  display: inline-block;
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #5b6a60;
  font-size: 24rpx;
  line-height: 40rpx;
}
.tag-chip.is-on { background: #2e7d5b; color: #ffffff; }
.tag-chip.is-manage { color: #2e7d5b; border: 1rpx dashed #9cc4b0; background: transparent; }
.batch-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.batch-count { color: #8a9b90; font-size: 24rpx; }
.batch-btn { color: #2e7d5b; font-size: 26rpx; padding: 8rpx 0 8rpx 24rpx; }
.filter-empty { color: #8a9b90; font-size: 26rpx; text-align: center; }
