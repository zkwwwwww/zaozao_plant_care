<view class="container {{plants.length ? 'has-add' : ''}}">
  <view class="card load-error" wx:if="{{loadError}}" bindtap="loadData">{{loadError}}，点此重试</view>
  <view class="card load-hint" wx:elif="{{loading}}">正在读取植物…</view>

  <!-- 小程序标识与功能 -->
  <view class="card brand">
    <image class="brand-logo" src="/assets/icons/logo.png" mode="aspectFill"></image>
    <view class="brand-text">
      <text class="brand-name">植早早</text>
      <text class="brand-desc">记录生长与养护，让每一次陪伴都有迹可循。</text>
      <text class="brand-login {{account.status === 'expired' ? 'is-expired' : ''}}" bindtap="goAccount">{{account.summary}}</text>
    </view>
    <view class="feature-row">
      <view class="feature-item" bindtap="goReminders">
        <text class="feature-title">季节提醒</text>
        <text class="feature-desc">浇水·施肥·换盆</text>
      </view>
      <view class="feature-item" bindtap="goEnvironments">
        <text class="feature-title">光照环境</text>
        <text class="feature-desc">强度与每日时长</text>
      </view>
      <view class="feature-item">
        <text class="feature-title">花费陪伴</text>
        <text class="feature-desc">投入与相处天数</text>
      </view>
      <view class="feature-item" bindtap="goMemorial">
        <text class="feature-title">纪念碑</text>
        <text class="feature-desc">离开也能留下</text>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="card stats">
    <view class="stat-item" bindtap="goReminders">
      <text class="stat-num">{{stats.count}}</text>
      <text class="stat-label">植物</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="togglePrices">
      <text class="stat-num {{pricesVisible ? '' : 'is-masked'}}">{{pricesVisible ? '¥' + stats.totalPrice : '****'}}</text>
      <text class="stat-label">总投入</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goReminders">
      <text class="stat-num {{stats.waterToday>0?'warn':''}}">{{stats.waterToday}}</text>
      <text class="stat-label">今日需浇水</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goReminders">
      <text class="stat-num {{stats.overdue>0?'danger':''}}">{{stats.overdue}}</text>
      <text class="stat-label">逾期待办</text>
    </view>
  </view>

  <!-- 季节浇水提示 -->
  <view class="card season-tip">
    <text class="tip-text">💧 {{seasonText}}</text>
  </view>

  <!-- 待办任务（仅展示即将到期与逾期） -->
  <view class="card" wx:if="{{tasks.length>0}}">
    <section-header title="近期待办" more-text="全部" bind:more="goReminders"></section-header>
    <task-row
      wx:for="{{tasks}}"
      wx:key="key"
      item-id="{{item.plantId}}"
      task-type="{{item.type}}"
      photo="{{item.photo}}"
      title="{{item.plantName}} · {{item.label}}"
      subtitle="到期 {{item.due}}"
      status-text="{{item.dueText}}"
      status-class="{{item.cls}}"
      bind:select="goDetail"
    ></task-row>
  </view>

  <!-- 植物图片墙 -->
  <section-header title="我的植物" more-text="纪念碑" bind:more="goMemorial"></section-header>

  <view class="grid" wx:if="{{plants.length>0}}">
    <view class="plant-card" wx:for="{{plants}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="photo-wrap">
        <plant-thumb src="{{item.photo}}" size="large"></plant-thumb>
        <text class="tag status-tag {{item.status==='健康'?'tag-green':(item.status==='生病中'||item.status==='需要关注')?'tag-red':'tag-amber'}}">{{item.status}}</text>
      </view>
      <view class="plant-body">
        <view class="plant-name-row">
          <text class="plant-name">{{item.name}}</text>
          <text class="plant-price {{pricesVisible ? '' : 'is-masked'}}" wx:if="{{item.price}}" catchtap="togglePrices">{{pricesVisible ? '¥' + item.price : '****'}}</text>
        </view>
        <text class="plant-meta">{{item.variety || '未填品种'}} · {{item.planting || '土培'}}</text>
        <text class="plant-env">{{item.envName}}</text>
        <text class="water-tip {{item.waterCls}}" wx:if="{{item.waterText}}">{{item.waterText}}</text>
      </view>
    </view>
  </view>

  <empty-state
    wx:elif="{{guest}}"
    image="/assets/illustrations/empty-plants.png"
    title="从这里记下每一株植物"
    description="可以先查看季节提醒、光照环境和纪念碑。准备保存自己的记录时，再在「我的」中登录"
  ></empty-state>

  <empty-state
    wx:elif="{{!loading && !loadError}}"
    image="/assets/illustrations/empty-plants.png"
    title="还没有植物，从第一株开始记下吧"
    description="拍照建档，浇水、光照、花费和陪伴都会留在这里"
    button-text="添加第一株植物"
    bind:action="goAdd"
  ></empty-state>

  <view class="add-bar" wx:if="{{plants.length>0}}" bindtap="goAdd">
    <text class="add-btn">＋ 添加植物</text>
  </view>
</view>

<view class="login-blur" wx:if="{{showLoginSheet}}" catchtouchmove="preventMove"></view>
<view class="login-sheet" wx:if="{{showLoginSheet}}">
    <view class="login-head">
      <image class="login-logo" src="/assets/icons/logo.png" mode="aspectFill"></image>
      <text class="login-apply">植早早 申请</text>
    </view>
    <text class="login-title">{{loginExpired ? '登录已过期，请重新授权' : '获取你的昵称、头像'}}</text>
    <text class="login-desc">头像可使用微信头像或上传图片。昵称请点输入框，键盘上方会出现微信昵称。</text>

    <button
      wx:if="{{needPrivacy}}"
      id="agree-privacy"
      class="privacy-btn"
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgreePrivacy"
    >先同意隐私保护指引</button>

    <view class="login-row">
      <text class="login-label">头像</text>
      <button class="login-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onLoginAvatar">
        <image class="login-avatar" src="{{loginAvatar || '/assets/icons/logo.png'}}" mode="aspectFill"></image>
      </button>
      <view class="login-album" bindtap="chooseLocalAvatar">上传</view>
    </view>

    <form bindsubmit="allowLogin">
      <view class="login-row">
        <text class="login-label">昵称</text>
        <input
          class="login-nick"
          type="nickname"
          name="nickName"
          maxlength="32"
          placeholder="点此使用微信昵称"
          placeholder-class="login-nick-placeholder"
          always-embed="{{true}}"
          adjust-position="{{true}}"
          cursor-spacing="80"
          confirm-type="done"
          bindblur="onLoginNickname"
          bindnicknamereview="onNicknameReview"
        />
      </view>

      <text class="login-error" wx:if="{{loginError}}">{{loginError}}</text>

      <view class="login-actions">
        <view class="login-refuse" catchtap="refuseLogin">拒绝</view>
        <button class="login-allow {{loginSubmitting ? 'is-disabled' : ''}}" form-type="submit">允许</button>
      </view>
    </form>
</view>
