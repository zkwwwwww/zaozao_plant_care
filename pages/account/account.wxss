.account-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
}

.privacy-btn {
  width: 100% !important;
  margin: 0 0 32rpx;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #eef7f1;
  color: #2e7d5b;
  font-size: 26rpx;
}

.privacy-btn::after {
  border: none;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 80rpx;
  overflow: hidden;
  background: #eef4f0;
  line-height: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.avatar-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a9b90;
}

.field {
  width: 100%;
  margin-top: 36rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6b7a70;
}

.nick-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f4f7f5;
  font-size: 30rpx;
  color: #26352c;
}

.nick-placeholder {
  color: #8a9b90;
}

.account-id {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #2e7d5b;
}

.account-note {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7a70;
}

.account-note.is-expired {
  color: #9b6819;
}

.account-card .btn-primary,
.account-card .btn-ghost {
  width: 100%;
  margin-top: 28rpx;
}

.btn-ghost.is-danger {
  color: #b34e48;
}

.btn-ghost {
  height: 80rpx;
  color: #2e7d5b;
  line-height: 80rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.status-card {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7a70;
}

.status-card.error {
  color: #b34e48;
}

.retry {
  margin-top: 16rpx;
  color: #2e7d5b;
  font-weight: 600;
}

.brand-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
}
.brand-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #eef4f0;
}
.brand-copy { flex: 1; min-width: 0; }
.brand-name {
  display: block;
  color: #26352c;
  font-size: 34rpx;
  font-weight: 700;
}
.brand-desc {
  display: block;
  margin-top: 6rpx;
  color: #6b7a70;
  font-size: 22rpx;
  line-height: 1.5;
}

.companion-card .section-title,
.menu-card .section-title {
  margin-bottom: 8rpx;
}
.companion-row,
.menu-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}
.menu-row:last-child { border-bottom: none; }
.companion-main,
.menu-copy { flex: 1; min-width: 0; margin: 0 16rpx; }
.companion-name,
.menu-title {
  display: block;
  color: #26352c;
  font-size: 28rpx;
  font-weight: 600;
}
.companion-days,
.menu-desc {
  display: block;
  margin-top: 6rpx;
  color: #8a9b90;
  font-size: 22rpx;
}
.companion-more,
.menu-arrow {
  color: #b9cdc1;
  font-size: 36rpx;
  line-height: 1;
}
.export-result { width: 100%; margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #eef4f0; }
.export-name { display: block; overflow-wrap: anywhere; color: #26352c; font-size: 25rpx; }
.export-hint { display: block; margin-top: 10rpx; color: #6b7a70; font-size: 22rpx; line-height: 1.6; }
.export-actions { display: flex; gap: 16rpx; }
.export-actions button { flex: 1; min-width: 0; padding: 0; font-size: 24rpx; }
.share-help { display: block; padding: 18rpx 0; color: #2e7d5b; font-size: 24rpx; text-align: center; }
