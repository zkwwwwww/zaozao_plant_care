/* pages/plant-edit/plant-edit.wxss */
.container { padding-bottom: 60rpx; }

/* 照片 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-cell {
  position: relative;
  width: 172rpx; height: 172rpx;
  border-radius: 16rpx; overflow: hidden;
  background: #eef4f0;
}
.photo-img { width: 100%; height: 100%; }
.photo-del {
  position: absolute; top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,.5); color: #fff;
  text-align: center; line-height: 40rpx;
  font-size: 32rpx; border-bottom-left-radius: 12rpx;
}
.photo-cell.add {
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed #b9cdc1;
}
.add-plus { font-size: 56rpx; color: #2e7d5b; }

/* 提醒提示 */
.reminder-hint {
  font-size: 24rpx; color: #2a6fa8;
  background: #e6f0fa; border-radius: 12rpx;
  padding: 16rpx 20rpx; margin-bottom: 8rpx;
}

/* 备注 */
.desc-textarea {
  width: 100%; min-height: 200rpx;
  font-size: 28rpx; line-height: 1.6;
}
