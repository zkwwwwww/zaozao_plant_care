.hero-title { display: block; font-size: 40rpx; font-weight: 700; color: #26352c; }
.hero-sub { display: block; margin-top: 10rpx; color: #6b7a70; font-size: 24rpx; line-height: 1.5; }
.photo-box {
  width: 100%;
  height: 360rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef4f0;
}
.photo-box image { width: 100%; height: 360rpx; display: block; }
.photo-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a9b90;
  font-size: 24rpx;
}
.plus { font-size: 56rpx; color: #2e7d5b; line-height: 1; margin-bottom: 8rpx; }
.result-name { display: block; color: #26352c; font-size: 34rpx; font-weight: 700; }
.result-desc { display: block; margin: 10rpx 0 20rpx; color: #6b7a70; font-size: 24rpx; line-height: 1.5; }
.tip-row { padding: 14rpx 0; border-top: 1rpx solid #f2f5f3; }
.tip-label { display: block; color: #2e7d5b; font-size: 22rpx; font-weight: 600; }
.tip-text { display: block; margin-top: 6rpx; color: #26352c; font-size: 26rpx; }
.btn-ghost { margin-top: 20rpx; }
.tip-title { display: block; color: #2e7d5b; font-size: 26rpx; font-weight: 700; }
.tip-desc { display: block; margin-top: 10rpx; color: #6b7a70; font-size: 24rpx; line-height: 1.6; }
