<view class="container">
  <view class="card load-error" wx:if="{{loadError}}" bindtap="load">{{loadError}}，点此重试</view>
  <view class="card load-hint" wx:elif="{{loading}}">正在读取环境…</view>
  <view class="env-tip card">
    <text class="tip-text">为不同的生长环境分别设置光照强度（lux 勒克斯）与每日光照时长，分类管理各环境下的植物。</text>
  </view>

  <view class="env-card" wx:for="{{envs}}" wx:key="id" bindtap="goEdit" data-id="{{item.id}}">
    <view class="env-left">
      <text class="env-icon">🪴</text>
      <view class="env-info">
        <text class="env-name">{{item.name}}</text>
        <text class="env-count">{{item.count}} 株植物</text>
      </view>
    </view>
    <view class="env-right">
      <view class="env-spec">☀️ {{item.lightIntensity || '—'}} lux</view>
      <view class="env-spec">⏱ {{item.lightHours || '—'}} 小时/天</view>
    </view>
  </view>

  <empty-state
    wx:if="{{guest}}"
    image="/assets/illustrations/empty-environments.png"
    title="按光照整理植物的生长空间"
    description="上方说明了如何记录光照强度和每日时长。登录后可以添加自己的环境"
  ></empty-state>

  <empty-state
    wx:elif="{{!loading && envs.length===0}}"
    image="/assets/illustrations/empty-environments.png"
    title="暂无环境分类"
    description="按光照强度和每日时长，为植物整理生长空间"
    button-text="添加环境"
    bind:action="goAdd"
  ></empty-state>

  <button class="btn-primary" bindtap="goAdd" wx:if="{{envs.length>0}}">＋ 添加环境</button>
</view>

<guest-gate show="{{guest}}"></guest-gate>
