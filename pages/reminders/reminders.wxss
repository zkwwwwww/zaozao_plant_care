/* pages/reminders/reminders.wxss */
.container { padding-bottom: 60rpx; }

.section-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #e9efeb;
}
.section-tab {
  flex: 1;
  padding: 20rpx 8rpx;
  border-radius: 14rpx;
  color: #6b7a70;
  font-size: 26rpx;
  text-align: center;
}
.section-tab.is-active {
  background: #ffffff;
  color: #2e7d5b;
  font-weight: 700;
}

.care-intro { display: flex; align-items: center; justify-content: space-between; }
.care-intro > view:first-child { flex: 1; min-width: 0; margin-right: 16rpx; }
.care-title { display: block; color: #26352c; font-size: 30rpx; font-weight: 700; }
.care-desc { display: block; margin-top: 8rpx; color: #8a9b90; font-size: 22rpx; }
.batch-care-btn,
.single-care-btn {
  width: auto;
  min-height: 0;
  margin: 0;
  border: none;
  background: #2e7d5b;
  color: #ffffff;
}
.batch-care-btn::after,
.single-care-btn::after { border: none; }
.batch-care-btn { padding: 0 24rpx; line-height: 68rpx; border-radius: 34rpx; font-size: 24rpx; }
.batch-care-btn[disabled] { background: #b8c5bd; color: #ffffff; }
.care-filter-scroll { width: 100%; margin-bottom: 14rpx; white-space: nowrap; }
.care-filter-inner { display: inline-flex; padding-right: 24rpx; }
.care-filter {
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #6b7a70;
  font-size: 23rpx;
}
.care-filter.is-on { background: #2e7d5b; color: #ffffff; }
.select-bar { display: flex; justify-content: space-between; padding: 0 8rpx 14rpx; color: #8a9b90; font-size: 23rpx; }
.select-all { color: #2e7d5b; }
.care-list { padding-top: 8rpx; padding-bottom: 8rpx; }
.care-row { display: flex; align-items: center; min-height: 108rpx; border-bottom: 1rpx solid #f2f5f3; }
.care-row:last-child { border-bottom: none; }
.care-check {
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border: 2rpx solid #b8c5bd;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}
.care-check.is-on { border-color: #2e7d5b; background: #2e7d5b; }
.care-row plant-thumb { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; margin-right: 18rpx; }
.care-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.care-name { color: #26352c; font-size: 28rpx; font-weight: 600; }
.care-sub { margin-top: 4rpx; color: #8a9b90; font-size: 22rpx; }
.single-care-btn { padding: 0 22rpx; line-height: 56rpx; border-radius: 28rpx; font-size: 23rpx; }

.record-list { padding-top: 8rpx; padding-bottom: 8rpx; }
.record-filters { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.record-filters picker { flex: 1; min-width: 0; }
.record-filter {
  overflow: hidden;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #5b6a60;
  font-size: 24rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-row { display: flex; align-items: center; min-height: 118rpx; border-bottom: 1rpx solid #f2f5f3; }
.record-row:last-child { border-bottom: none; }
.record-row plant-thumb { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; margin-right: 18rpx; }
.record-main { flex: 1; min-width: 0; }
.record-name { display: block; overflow: hidden; color: #26352c; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.record-actions { flex-shrink: 0; display: flex; align-items: center; margin-left: 16rpx; }
.record-date { color: #8a9b90; font-size: 21rpx; line-height: 40rpx; }
.record-note { display: block; overflow: hidden; margin-top: 8rpx; color: #6b7a70; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.record-edit { margin-left: 18rpx; color: #2e7d5b; font-size: 23rpx; line-height: 40rpx; }
.record-photo { display: none !important; }
.overdue-bar { background: #fbe9e7; border: 1rpx solid #f2d3cf; }
.ob-text { font-size: 26rpx; color: #c0554f; font-weight: 600; }

.reminder-tabs {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}
.reminder-tabs-inner {
  display: inline-flex;
  min-width: 100%;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #e9efeb;
}
.reminder-tab {
  flex: 1;
  min-width: 148rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: #6b7a70;
  font-size: 25rpx;
  line-height: 1;
  text-align: center;
}
.reminder-tab.is-active {
  background: #ffffff;
  color: #2e7d5b;
  font-weight: 700;
}

.grouped-card { padding-top: 18rpx; }
.group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f2f5f3;
  color: #26352c;
  font-size: 28rpx;
  font-weight: 700;
}
.group-count { color: #8a9b90; font-size: 23rpx; font-weight: 400; }

.task-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f2f5f3; }
.task-row:last-child { border-bottom: none; }
.task-photo-wrap { width: 72rpx; height: 72rpx; margin-right: 18rpx; }
.task-photo { width: 72rpx; height: 72rpx; border-radius: 14rpx; background: #eef4f0; }
.task-photo.placeholder { display: flex; align-items: center; justify-content: center; }
.ph-icon { font-size: 36rpx; }
.task-info { flex: 1; display: flex; flex-direction: column; }
.task-name { font-size: 28rpx; font-weight: 600; }
.task-date { font-size: 22rpx; color: #8a9b90; margin-top: 4rpx; }
.task-actions { display: flex; align-items: center; margin-left: 12rpx; }
.task-complete {
  flex: 0 0 auto;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: #eef4f0;
  color: #2e7d5b;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

/* 分组 */
.group-card { padding: 24rpx; }
.group-head { display: flex; align-items: center; }
.group-head plant-thumb {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
}
.g-photo { width: 72rpx; height: 72rpx; border-radius: 14rpx; background: #eef4f0; margin-right: 18rpx; }
.g-photo.placeholder { display: flex; align-items: center; justify-content: center; }
.g-name { font-size: 30rpx; font-weight: 700; flex: 1; }
.g-int { font-size: 22rpx; color: #8a9b90; }
.g-tasks { margin-top: 16rpx; border-top: 1rpx solid #f2f5f3; padding-top: 8rpx; }
.g-task { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; }
.g-type { flex: 0 0 72rpx; color: #2e7d5b; font-size: 25rpx; font-weight: 600; }
.g-tinfo { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.g-tname { font-size: 26rpx; font-weight: 600; }
.g-tdate { font-size: 22rpx; color: #8a9b90; margin-top: 2rpx; white-space: nowrap; }

.empty.small { padding: 60rpx 20rpx; }
