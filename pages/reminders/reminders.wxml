<view class="container">

  <!-- 季节提示 -->
  <view class="card season-card">
    <view class="season-title">🌦 {{seasonText}}</view>
    <view class="season-legend">
      <view class="lg-item"><text class="lg-dot green"></text>春/秋 10天</view>
      <view class="lg-item"><text class="lg-dot amber"></text>夏 5天</view>
      <view class="lg-item"><text class="lg-dot blue"></text>冬 15天</view>
    </view>
    <view class="season-note">每株植物可在「编辑」中单独设置浇水/施肥/换盆间隔，留空则按季节自动。</view>
  </view>

  <!-- 逾期总览 -->
  <view class="card overdue-bar" wx:if="{{overdueCount>0}}">
    <text class="ob-text">⚠ 共 {{overdueCount}} 项已逾期</text>
  </view>

  <!-- 全部待办（近期及逾期优先） -->
  <view class="card">
    <section-header title="全部待办"></section-header>
    <task-row
      wx:for="{{flatTasks}}"
      wx:key="key"
      item-id="{{item.plantId}}"
      task-type="{{item.type}}"
      photo="{{item.photo}}"
      title="{{item.plantName}} · {{item.label}}"
      subtitle="到期 {{item.due}}"
      status-text="{{item.dueText}}"
      status-class="{{item.cls}}"
      show-complete="{{true}}"
      bind:select="goDetail"
      bind:complete="completeTask"
    ></task-row>
    <empty-state
      wx:if="{{flatTasks.length===0}}"
      compact="{{true}}"
      image="/assets/illustrations/empty-reminders.png"
      title="当前没有近期或逾期的养护任务"
      description="完成养护后及时记录，下次到期日会自动更新"
    ></empty-state>
  </view>

  <!-- 按植物分组 -->
  <section-header title="按植物查看"></section-header>
  <view class="card group-card" wx:for="{{groups}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="group-head">
      <plant-thumb src="{{item.photo}}" size="small"></plant-thumb>
      <text class="g-name">{{item.name}}</text>
      <text class="g-int">浇水间隔 {{item.waterInterval}} 天</text>
    </view>
    <view class="g-tasks">
      <view class="g-task" wx:for="{{item.tasks}}" wx:for-item="t" wx:key="type">
        <text class="g-emoji">{{t.type==='water'?'💧':t.type==='fertilize'?'🌱':'🪴'}}</text>
        <view class="g-tinfo">
          <text class="g-tname">{{t.label}}</text>
          <text class="g-tdate">{{t.due}}</text>
        </view>
        <text class="tag {{t.cls}}">{{t.dueText}}</text>
        <view class="task-complete" catchtap="completeTask" data-id="{{item.id}}" data-type="{{t.type}}">完成</view>
      </view>
    </view>
  </view>

</view>
