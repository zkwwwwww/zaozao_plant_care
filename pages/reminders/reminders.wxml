<share-preview wx:if="{{appSharePreview}}" single-page="{{appShareSinglePage}}" bindsharehelp="showShareHelp"></share-preview>
<block wx:else>
<notice-center></notice-center>
<view class="container">
  <view class="card load-error" wx:if="{{loadError}}" bindtap="load">{{loadError}}，点此重试</view>
  <view class="card load-hint" wx:elif="{{loading}}">正在读取养护数据…</view>

  <view class="section-tabs">
    <view
      class="section-tab {{activeSection===item.key ? 'is-active' : ''}}"
      wx:for="{{sections}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchSection"
    >{{item.label}}</view>
  </view>

  <!-- 单株与批量养护 -->
  <block wx:if="{{activeSection==='care'}}">
    <view class="card care-intro">
      <view>
        <text class="care-title">记录今天的养护</text>
        <text class="care-desc">选择植物可批量操作，单独记录可填写备注和照片</text>
      </view>
      <button class="batch-care-btn" bindtap="batchCare" disabled="{{busy || loading || loadError || !selectedCareCount}}">
        批量养护{{selectedCareCount ? '（' + selectedCareCount + '）' : ''}}
      </button>
    </view>
    <scroll-view class="care-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="care-filter-inner">
        <text
          class="care-filter {{careFilter===item.key ? 'is-on' : ''}}"
          wx:for="{{careFilters}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="selectCareFilter"
        >{{item.label}}</text>
      </view>
    </scroll-view>
    <view class="select-bar" wx:if="{{carePlants.length}}">
      <text>已选 {{selectedCareCount}} 株</text>
      <text class="select-all" bindtap="selectAllCare">{{allCareSelected ? '取消全选' : '全选筛选结果'}}</text>
    </view>
    <view class="card care-list" wx:if="{{carePlants.length}}">
      <view class="care-row" wx:for="{{carePlants}}" wx:key="id">
        <view class="care-check {{item.selected ? 'is-on' : ''}}" data-id="{{item.id}}" bindtap="toggleCareSelection">
          {{item.selected ? '✓' : ''}}
        </view>
        <plant-thumb src="{{item.photo}}"></plant-thumb>
        <view class="care-main" data-id="{{item.id}}" bindtap="goDetail">
          <text class="care-name">{{item.name}}</text>
          <text class="care-sub">{{item.sub}}</text>
        </view>
        <button class="single-care-btn" data-id="{{item.id}}" bindtap="startCare">养护</button>
      </view>
    </view>
    <empty-state
      wx:if="{{!carePlants.length && !loading}}"
      compact="{{true}}"
      image="/assets/illustrations/empty-plants.png"
      title="还没有可养护的植物"
      description="添加植物后，可以在这里进行单株或批量养护"
    ></empty-state>
  </block>

  <!-- 养护提醒 -->
  <block wx:if="{{activeSection==='reminder'}}">
    <view class="card reminder-batch" wx:if="{{taskCount}}">
      <view class="care-intro">
        <view><text class="care-title">待维护清单 · {{taskCount}} 项</text><text class="care-desc">多选或整组完成，不必逐株记录</text></view>
        <button class="batch-care-btn" bindtap="toggleBatchSelection" disabled="{{busy || loading || loadError}}">{{batchSelecting ? '退出多选' : '批量维护'}}</button>
      </view>
      <block wx:if="{{batchSelecting}}">
        <view class="task-selection-actions">
          <text data-scope="due" bindtap="selectTaskScope">全选今日 / 逾期</text>
          <text data-scope="all" bindtap="selectTaskScope">全选清单</text>
          <text data-scope="none" bindtap="selectTaskScope">取消全选</text>
        </view>
        <view class="care-intro"><text class="care-desc">已选 {{selectedTaskCount}} 项，包含未翻页的事项</text><button class="batch-care-btn" bindtap="completeSelectedTasks" disabled="{{busy || loading || loadError || !selectedTaskCount}}">批量完成</button></view>
      </block>
      <text class="care-desc" wx:if="{{batchProgress}}">{{batchProgress}}</text>
    </view>
    <view class="card" wx:if="{{upcomingWindow}}"><text class="care-desc">正在显示今天、逾期和未来两天的养护事项。</text><text class="section-more" bindtap="usePlantWindow">按每株设置显示</text></view>
    <view class="card" wx:if="{{manualTaskPlants.length}}">
      <section-header title="管理手动任务"></section-header>
      <view class="list-row" wx:for="{{manualTaskPlants}}" wx:key="id" data-id="{{item.id}}" bindtap="goManualTasks"><text class="list-title">{{item.name}}</text><text class="list-action">{{item.count}} 项，前往勾选 ›</text></view>
    </view>
    <view class="card overdue-bar" wx:if="{{overdueCount>0}}">
      <text class="ob-text">⚠ 共 {{overdueCount}} 项已逾期</text>
    </view>

    <scroll-view class="reminder-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="reminder-tabs-inner">
        <view
          class="reminder-tab {{activeView===item.key ? 'is-active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="switchView"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="card" wx:if="{{activeView==='all'}}">
      <section-header title="全部待办"></section-header>
      <task-row
        wx:for="{{flatTasks}}"
        wx:key="key"
        item-id="{{item.plantId}}"
        task-type="{{item.type}}"
        task-id="{{item.taskId || ''}}"
        task-key="{{item.key}}"
        selectable="{{batchSelecting}}"
        selected="{{item.selected}}"
        photo="{{item.photo}}"
        title="{{item.plantName}} · {{item.label}}"
        subtitle="{{item.due ? '到期 ' + item.due : '手动任务，无到期日'}}"
        status-text="{{item.dueText}}"
        status-class="{{item.cls}}"
        show-complete="{{!batchSelecting}}"
        show-ignore="{{!batchSelecting && item.type!=='manual'}}"
        bind:check="toggleTaskSelection"
        bind:select="goDetail"
        bind:complete="completeTask"
        bind:ignore="ignoreTask"
      ></task-row>
      <empty-state
        wx:if="{{flatTasks.length===0}}"
        compact="{{true}}"
        image="/assets/illustrations/empty-reminders.png"
        title="当前没有近期或逾期的养护任务"
        description="完成养护后及时记录，下次到期日会自动更新"
      ></empty-state>
    </view>

    <block wx:if="{{activeView==='time'}}">
      <view class="card grouped-card" wx:for="{{timeGroups}}" wx:for-item="group" wx:key="key">
        <view class="group-title"><text>{{group.label}}</text><button class="group-complete" data-time="{{group.key}}" bindtap="completeTaskGroup" disabled="{{busy || loading || loadError}}">整组完成</button></view>
        <task-row
          wx:for="{{group.items}}"
          wx:key="key"
          item-id="{{item.plantId}}"
          task-type="{{item.type}}"
          task-id="{{item.taskId || ''}}"
          task-key="{{item.key}}"
          selectable="{{batchSelecting}}"
          selected="{{item.selected}}"
          photo="{{item.photo}}"
          title="{{item.plantName}} · {{item.label}}"
          subtitle="{{item.due ? '到期 ' + item.due : '手动任务，无到期日'}}"
          status-text="{{item.dueText}}"
          status-class="{{item.cls}}"
          show-complete="{{!batchSelecting}}"
          show-ignore="{{!batchSelecting && item.type!=='manual'}}"
          bind:check="toggleTaskSelection"
          bind:select="goDetail"
          bind:complete="completeTask"
          bind:ignore="ignoreTask"
        ></task-row>
      </view>
    </block>

    <block wx:if="{{activeView==='plant'}}">
      <view class="card group-card" wx:for="{{groups}}" wx:key="id">
        <view class="group-head">
          <plant-thumb src="{{item.photo}}" size="small"></plant-thumb>
          <text class="g-name" data-id="{{item.id}}" bindtap="goDetail">{{item.name}}</text>
          <button class="group-complete" data-plant="{{item.id}}" bindtap="completeTaskGroup" disabled="{{busy || loading || loadError}}">整株完成</button>
        </view>
        <view class="g-tasks">
          <task-row wx:for="{{item.tasks}}" wx:for-item="t" wx:key="key"
            item-id="{{item.id}}" task-type="{{t.type}}" task-id="{{t.taskId || ''}}" task-key="{{t.key}}"
            title="{{t.label}}" subtitle="{{t.due ? '到期 ' + t.due : '手动任务，无到期日'}}"
            photo="{{item.photo}}" status-text="{{t.dueText}}" status-class="{{t.cls}}"
            selectable="{{batchSelecting}}" selected="{{t.selected}}"
            show-complete="{{!batchSelecting}}" show-ignore="{{!batchSelecting && t.type!=='manual'}}"
            bind:check="toggleTaskSelection" bind:select="goDetail" bind:complete="completeTask" bind:ignore="ignoreTask"
          ></task-row>
        </view>
      </view>
    </block>

    <block wx:if="{{activeView==='type'}}">
      <view class="card grouped-card" wx:for="{{typeGroups}}" wx:for-item="group" wx:key="type">
        <view class="group-title"><text>{{group.label}}</text><button class="group-complete" data-type="{{group.type}}" bindtap="completeTaskGroup" disabled="{{busy || loading || loadError}}">整组完成</button></view>
        <task-row
          wx:for="{{group.items}}"
          wx:key="key"
          item-id="{{item.plantId}}"
          task-type="{{item.type}}"
          task-id="{{item.taskId || ''}}"
          task-key="{{item.key}}"
          selectable="{{batchSelecting}}"
          selected="{{item.selected}}"
          photo="{{item.photo}}"
          title="{{item.plantName}}"
          subtitle="{{item.due ? '到期 ' + item.due : '手动任务，无到期日'}}"
          status-text="{{item.dueText}}"
          status-class="{{item.cls}}"
          show-complete="{{!batchSelecting}}"
          show-ignore="{{!batchSelecting && item.type!=='manual'}}"
          bind:check="toggleTaskSelection"
          bind:select="goDetail"
          bind:complete="completeTask"
          bind:ignore="ignoreTask"
        ></task-row>
      </view>
    </block>
  </block>

  <!-- 养护记录与备注 -->
  <block wx:if="{{activeSection==='records'}}">
    <view class="record-filters">
      <picker range="{{recordPlants}}" range-key="name" value="{{recordPlantIndex}}" bindchange="onRecordPlant">
        <view class="record-filter">{{recordPlants[recordPlantIndex].name}} ▾</view>
      </picker>
      <picker range="{{recordTypes}}" value="{{recordTypeIndex}}" bindchange="onRecordType">
        <view class="record-filter">{{recordTypes[recordTypeIndex]}} ▾</view>
      </picker>
    </view>
    <view class="card record-list" wx:if="{{careRecords.length}}">
      <view class="record-row" wx:for="{{careRecords}}" wx:key="key">
        <plant-thumb src="{{item.photo}}"></plant-thumb>
        <view class="record-main" data-id="{{item.plantId}}" bindtap="goDetail">
          <text class="record-name">{{item.plantName}} · {{item.type}}</text>
          <text class="record-note">{{item.content || '无备注'}}</text>
        </view>
        <view class="record-actions">
          <text class="record-date">{{item.date}}</text>
          <text class="record-edit" data-id="{{item.id}}" data-plant-id="{{item.plantId}}" catchtap="editRecord">编辑</text>
          <text class="record-delete" data-id="{{item.id}}" catchtap="deleteRecord">删除</text>
        </view>
      </view>
    </view>
    <empty-state
      wx:if="{{!careRecords.length && !loading}}"
      compact="{{true}}"
      image="/assets/illustrations/empty-records.png"
      title="还没有养护记录"
      description="完成养护时可以补充备注和照片，记录会汇总在这里"
    ></empty-state>
  </block>
</view>

<guest-gate show="{{guest}}"></guest-gate>
</block>
