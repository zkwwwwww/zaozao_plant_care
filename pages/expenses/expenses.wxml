<share-preview wx:if="{{appSharePreview}}" single-page="{{appShareSinglePage}}" bindsharehelp="showShareHelp"></share-preview>
<block wx:else>
<notice-center></notice-center>
<view class="container has-fixed-bar">
  <view class="card load-error" wx:if="{{loadError}}" bindtap="load">{{loadError}}，点此重试</view>

  <empty-state
    wx:if="{{guest}}"
    image="/assets/illustrations/empty-plants.png"
    title="把肥料、药剂、补光灯都记下来"
    description="按日、周、月、年看花了多少。在「我的」中登录后即可开始记账"
  ></empty-state>

  <block wx:else>
    <view class="card summary three">
      <view class="summary-item">
        <text class="summary-label">总花费</text>
        <text class="summary-num">¥{{grandTotal}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">植物花费</text>
        <text class="summary-num">¥{{plantValue}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">其他花费</text>
        <text class="summary-num">¥{{allTotal}}</text>
      </view>
    </view>

    <view class="card pyramid-card" wx:if="{{topPlant}}" bindtap="goPlant">
      <text class="pyramid-label">价格金字塔 · 最贵的一棵</text>
      <view class="pyramid">
        <view class="pyramid-peak">
          <plant-thumb src="{{topPlant.photo}}"></plant-thumb>
          <view class="pyramid-copy">
            <text class="pyramid-name">{{topPlant.name}}</text>
            <text class="pyramid-price">¥{{topPlant.price}}</text>
          </view>
        </view>
        <view class="pyramid-base"></view>
      </view>
    </view>

    <view class="card">
      <view class="segmented">
        <text class="segmented-item {{mode === item.key ? 'is-on' : ''}}" wx:for="{{modes}}" wx:key="key" data-key="{{item.key}}" bindtap="switchMode">{{item.label}}</text>
      </view>
      <view class="range-row" wx:if="{{mode === 'custom'}}">
        <picker mode="date" value="{{rangeStart}}" end="{{today}}" bindchange="onRangeStart">
          <view class="range-field">{{rangeStart}} ▾</view>
        </picker>
        <text class="range-sep">至</text>
        <picker mode="date" value="{{rangeEnd}}" end="{{today}}" bindchange="onRangeEnd">
          <view class="range-field">{{rangeEnd}} ▾</view>
        </picker>
      </view>
      <view class="chart {{series.length > 12 ? 'is-dense' : ''}}">
        <view class="bar-col {{item.selected ? 'is-on' : ''}}" wx:for="{{series}}" wx:key="key" data-key="{{item.key}}" bindtap="pickBar">
          <view class="bar-track">
            <view class="bar" style="height: {{item.percent}}%;"></view>
          </view>
          <text class="bar-label">{{item.label}}</text>
        </view>
      </view>
      <view class="period-head">
        <text class="period-title">{{periodTitle}}</text>
        <text class="period-total">¥{{periodTotal}}</text>
      </view>
      <view class="cat-row" wx:for="{{categories}}" wx:key="name">
        <text class="cat-name">{{item.name}}</text>
        <view class="cat-track"><view class="cat-bar" style="width: {{item.percent}}%;"></view></view>
        <text class="cat-total">¥{{item.total}}</text>
      </view>
      <text class="muted" wx:if="{{!categories.length && !loading}}">这段时间没有花费</text>
    </view>

    <view class="card" wx:if="{{items.length}}">
      <view class="section-title">明细（{{items.length}}）</view>
      <view class="list-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goEdit">
        <view class="list-main no-thumb">
          <text class="list-title">{{item.category}}</text>
          <text class="list-sub">{{item.date}}{{item.note ? ' · ' + item.note : ''}}</text>
        </view>
        <text class="list-side">¥{{item.amountText}}</text>
      </view>
    </view>

    <empty-state
      wx:if="{{!hasData && !loading && !loadError}}"
      compact="{{true}}"
      image="/assets/illustrations/empty-records.png"
      title="还没有花费记录"
      description="买了肥料或补光灯，就记一笔"
    ></empty-state>

    <view class="card price-card">
      <view class="price-head">
        <view>
          <text class="section-title">植物花费排行</text>
          <text class="price-count">{{pricedCount}} 株计入{{unpricedCount ? '，' + unpricedCount + ' 株未填' : ''}}</text>
        </view>
        <text class="price-total">¥{{plantValue}}</text>
      </view>
      <view class="sort-row">
        <text class="sort-chip {{priceSortKey==='price' ? 'is-on' : ''}}" data-key="price" bindtap="switchPriceSort">按价格{{priceSortKey==='price' ? (priceSortAsc ? '↑' : '↓') : ''}}</text>
        <text class="sort-chip {{priceSortKey==='time' ? 'is-on' : ''}}" data-key="time" bindtap="switchPriceSort">按时间{{priceSortKey==='time' ? (priceSortAsc ? '↑' : '↓') : ''}}</text>
      </view>
      <view class="list-row" wx:for="{{priceItems}}" wx:key="id" data-id="{{item.id}}" bindtap="goPricePlant">
        <plant-thumb src="{{item.photo}}"></plant-thumb>
        <view class="list-main">
          <text class="list-title">{{item.name}}</text>
          <text class="list-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
        <text class="list-side">¥{{item.price}}</text>
      </view>
      <text class="muted" wx:if="{{!priceItems.length}}">在植物编辑页填写价格后，会汇总到这里</text>
    </view>
  </block>
</view>

<view class="fixed-bar">
  <button class="btn-primary" bindtap="goAdd">＋ 记一笔</button>
</view>
</block>
