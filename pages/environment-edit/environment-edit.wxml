<view class="container">
  <view class="card">
    <view class="section-title">环境信息</view>

    <view class="form-item">
      <text class="form-label">名称 *</text>
      <input class="form-input" placeholder="如：阳台直射 / 半阴散射光" placeholder-class="form-placeholder" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">光照强度</text>
      <input class="form-input" type="digit" placeholder="如：5000" placeholder-class="form-placeholder" value="{{form.lightIntensity}}" data-field="lightIntensity" bindinput="onNumInput" />
      <text class="form-unit">lux</text>
    </view>

    <view class="form-item" style="border-bottom:none;">
      <text class="form-label">每日光照时长</text>
      <input class="form-input" type="digit" placeholder="如：8" placeholder-class="form-placeholder" value="{{form.lightHours}}" data-field="lightHours" bindinput="onNumInput" />
      <text class="form-unit">小时/天</text>
    </view>
  </view>

  <view class="lux-ref">
    <view class="lux-ref-title">光照强度参考（lux）</view>
    <view class="lux-row"><text>直射阳光</text><text>10,000 – 100,000</text></view>
    <view class="lux-row"><text>明亮散射光</text><text>5,000 – 10,000</text></view>
    <view class="lux-row"><text>半阴散射光</text><text>2,000 – 5,000</text></view>
    <view class="lux-row"><text>弱光阴处</text><text>{{'<'}} 2,000</text></view>
  </view>

  <button class="btn-primary" bindtap="save">{{isEdit ? '保存修改' : '添加环境'}}</button>

  <button class="btn-danger" wx:if="{{isEdit}}" bindtap="deleteEnv">删除该环境</button>
</view>
