/* pages/environment-edit/environment-edit.wxss */
.container { padding-bottom: 60rpx; }

.lux-ref {
  background: #eef4f0; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx;
}
.lux-ref-title { font-size: 26rpx; font-weight: 700; margin-bottom: 16rpx; color: #2e7d5b; }
.lux-row {
  display: flex; justify-content: space-between;
  font-size: 24rpx; color: #5b6a60; padding: 8rpx 0;
  border-bottom: 1rpx solid #e0ebe4;
}
.lux-row:last-child { border-bottom: none; }
